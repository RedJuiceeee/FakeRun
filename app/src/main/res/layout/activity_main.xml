<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FakeRun · 本地模拟位置" android:textSize="22sp" android:textStyle="bold" android:textColor="#12413B" android:padding="8dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/tab_ready" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="准备" />
    <Button android:id="@+id/tab_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="路线与参数" />
    <Button android:id="@+id/tab_run" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="运行" />
  </LinearLayout>
  <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A43716" android:padding="8dp" android:accessibilityLiveRegion="polite" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/page_ready" android:layout_width="match_parent" android:layout_height="match_parent">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
        <TextView android:id="@+id/last_session" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#A43716" android:paddingBottom="8dp" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. 同意隐私说明，启用百度地图。\n2. 配置自己的百度 Android SDK AK，绑定包名与签名 SHA-1。\n3. 允许精确定位、打开系统定位。\n4. 在开发者选项选择 FakeRun 为模拟位置信息应用。\n\n模拟输出保留系统 mock 标记，不保证所有第三方应用采用。手工路线只支持中国大陆普通城市区域。" android:textSize="16sp" android:lineSpacingExtra="5dp" />
        <Button android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看并同意隐私说明" />
        <Button android:id="@+id/ak_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AK 与签名配置说明" />
        <Button android:id="@+id/permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="申请定位与通知权限" />
        <Button android:id="@+id/location_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开系统定位设置" />
        <Button android:id="@+id/developer_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="打开开发者选项" />
        <Button android:id="@+id/readiness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="检查开始条件" />
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/page_route" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
      <FrameLayout android:id="@+id/map_host" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2">
        <TextView android:id="@+id/map_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="同意隐私并配置 AK 后显示地图" android:textSize="17sp" />
      </FrameLayout>
      <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:id="@+id/route_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="相邻节点直线连接，请自行补足弯道。长按节点拖动，点击节点编辑或删除。" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/draw" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="开启绘制" />
            <Button android:id="@+id/undo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="撤销" />
            <Button android:id="@+id/close_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="闭合路线" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/new_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="新建" />
            <Button android:id="@+id/save_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="保存路线" />
            <Button android:id="@+id/load_route" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="路线列表" />
          </LinearLayout>
          <LinearLayout android:id="@+id/config_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="步行占比 = WALK 巡航时间 / 全部移动时间。走跑切换、起步、减速计入分母，停留与用户暂停不计。参数修改作用于下一次运行。" />
          <Button android:id="@+id/prepare" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成完整预览" />
          <Button android:id="@+id/cancel_prepare" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="取消生成" android:visibility="gone" />
        </LinearLayout>
      </ScrollView>
    </LinearLayout>
    <ScrollView android:id="@+id/page_run" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
        <TextView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请先绘制闭合路线并生成预览" android:textSize="16sp" android:lineSpacingExtra="4dp" />
        <Button android:id="@+id/show_map" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看计划与实时轨迹地图" />
        <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开始模拟" android:enabled="false" />
        <TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textSize="17sp" android:lineSpacingExtra="5dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <Button android:id="@+id/pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="暂停" android:enabled="false" />
          <Button android:id="@+id/resume" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="继续" android:enabled="false" />
          <Button android:id="@+id/end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="平滑结束" android:enabled="false" />
        </LinearLayout>
        <Button android:id="@+id/immediate_end" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="立即结束并释放模拟位置" android:enabled="false" />
      </LinearLayout>
    </ScrollView>
  </FrameLayout>
</LinearLayout>
